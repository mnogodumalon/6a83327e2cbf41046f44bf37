{
  "slug": "sitzungsanmeldung",
  "component": "Sitzungsanmeldung",
  "title": "Sitzungsanmeldung",
  "link_param": {
    "name": "sitzung_id",
    "entity": "sitzungen",
    "label_field": "titel",
    "secondary_field": "datum_uhrzeit"
  },
  "endpoints": [
    {
      "entity": "sitzungen",
      "op": "list",
      "fields": ["titel", "datum_uhrzeit", "ort", "art", "beschreibung", "anmeldefrist", "max_teilnehmer", "einladungsstatus"],
      "scope": "r.v_einladungsstatus == 'versandt'",
      "scope_description": "zeigt nur Sitzungen mit Status 'Versandt' (aktive Einladungen)",
      "max_records": 200
    },
    {
      "entity": "mitglieder",
      "op": "list",
      "fields": ["vorname", "nachname", "email", "status"],
      "scope": "r.v_status == 'aktiv'",
      "scope_description": "zeigt nur aktive Mitglieder zur E-Mail-Identifikation",
      "max_records": 500
    },
    {
      "entity": "sitzungen",
      "op": "create",
      "fields": ["angemeldete_mitglieder"]
    }
  ]
}
